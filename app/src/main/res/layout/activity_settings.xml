<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:liftOnScrollColor="?attr/colorSurfaceContainer"
        app:liftOnScrollTargetViewId="@id/settings_scroll">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            style="?attr/collapsingToolbarLayoutLargeStyle"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:title="@string/settings_title"
            app:toolbarId="@+id/settings_toolbar">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/settings_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationContentDescription="@string/action_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="?attr/colorOnSurfaceVariant" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Feedback -->
            <TextView
                style="@style/Widget.QuickSlate.SectionLabel"
                android:text="@string/section_feedback" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.QuickSlate.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <!-- Haptic feedback setting -->
                    <LinearLayout
                        android:id="@+id/row_haptics"
                        style="@style/Widget.QuickSlate.SettingsRow">

                        <ImageView
                            style="@style/Widget.QuickSlate.SettingsRowIcon"
                            android:src="@drawable/ic_vibration" />

                        <LinearLayout
                            style="@style/Widget.QuickSlate.SettingsRowText">

                            <TextView
                                style="@style/Widget.QuickSlate.SettingsRowTitle"
                                android:text="@string/setting_haptics" />

                            <TextView
                                style="@style/Widget.QuickSlate.SettingsRowSubtitle"
                                android:text="@string/setting_haptics_summary" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_haptics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false" />

                    </LinearLayout>

                    <!-- Haptic strength -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="56dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Widget.QuickSlate.SettingsRowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/setting_haptics_strength" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/group_strength"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_light"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:minHeight="48dp"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/haptics_light"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="11sp"
                                app:autoSizeMaxTextSize="14sp"
                                app:autoSizeStepGranularity="1sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_medium"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:minHeight="48dp"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/haptics_medium"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="11sp"
                                app:autoSizeMaxTextSize="14sp"
                                app:autoSizeStepGranularity="1sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_heavy"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:minHeight="48dp"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/haptics_heavy"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="11sp"
                                app:autoSizeMaxTextSize="14sp"
                                app:autoSizeStepGranularity="1sp" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About -->
            <TextView
                style="@style/Widget.QuickSlate.SectionLabel"
                android:layout_marginTop="24dp"
                android:text="@string/section_about" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.QuickSlate.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:id="@+id/row_source_code"
                        style="@style/Widget.QuickSlate.SettingsRow">

                        <ImageView
                            style="@style/Widget.QuickSlate.SettingsRowIcon"
                            android:src="@drawable/ic_code" />

                        <LinearLayout
                            style="@style/Widget.QuickSlate.SettingsRowText">

                            <TextView
                                style="@style/Widget.QuickSlate.SettingsRowTitle"
                                android:text="@string/setting_source_code" />

                        </LinearLayout>

                        <ImageView
                            style="@style/Widget.QuickSlate.SettingsRowChevron"
                            android:src="@drawable/ic_chevron_right" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_licenses"
                        style="@style/Widget.QuickSlate.SettingsRow">

                        <ImageView
                            style="@style/Widget.QuickSlate.SettingsRowIcon"
                            android:src="@drawable/ic_description" />

                        <LinearLayout
                            style="@style/Widget.QuickSlate.SettingsRowText">

                            <TextView
                                style="@style/Widget.QuickSlate.SettingsRowTitle"
                                android:text="@string/setting_licenses" />

                        </LinearLayout>

                        <ImageView
                            style="@style/Widget.QuickSlate.SettingsRowChevron"
                            android:src="@drawable/ic_chevron_right" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_privacy"
                        style="@style/Widget.QuickSlate.SettingsRow">

                        <ImageView
                            style="@style/Widget.QuickSlate.SettingsRowIcon"
                            android:src="@drawable/ic_shield" />

                        <LinearLayout
                            style="@style/Widget.QuickSlate.SettingsRowText">

                            <TextView
                                style="@style/Widget.QuickSlate.SettingsRowTitle"
                                android:text="@string/setting_privacy" />

                        </LinearLayout>

                        <ImageView
                            style="@style/Widget.QuickSlate.SettingsRowChevron"
                            android:src="@drawable/ic_chevron_right" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_version"
                        style="@style/Widget.QuickSlate.SettingsRow">

                        <ImageView
                            style="@style/Widget.QuickSlate.SettingsRowIcon"
                            android:src="@drawable/ic_info" />

                        <LinearLayout
                            style="@style/Widget.QuickSlate.SettingsRowText">

                            <TextView
                                style="@style/Widget.QuickSlate.SettingsRowTitle"
                                android:text="@string/setting_version" />

                            <TextView
                                android:id="@+id/version_value"
                                style="@style/Widget.QuickSlate.SettingsRowSubtitle" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Developer -->
            <TextView
                style="@style/Widget.QuickSlate.SectionLabel"
                android:layout_marginTop="24dp"
                android:text="@string/section_developer" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.QuickSlate.DeveloperCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:contentDescription="@string/dev_name"
                            android:scaleType="centerCrop"
                            android:src="@drawable/musaddiqbaluch" />

                        <TextView
                            style="@style/Widget.QuickSlate.DeveloperName"
                            android:text="@string/dev_name" />

                    </LinearLayout>

                    <TextView
                        style="@style/Widget.QuickSlate.DeveloperDescription"
                        android:text="@string/dev_description" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_github"
                        style="@style/Widget.QuickSlate.DeveloperButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="20dp"
                        android:text="@string/github_button" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>