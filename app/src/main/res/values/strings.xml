    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_button">Close</string>

    <string name="privacy_overview_title">Overview</string>
    <string name="privacy_overview_body">Quick Slate is a shortcut app. It only opens Android\'s own system settings screens.</string>

    <string name="privacy_internet_title">Internet</string>
    <string name="privacy_internet_body">The app has no Internet permission and works fully offline.</string>

    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">The only permission is vibration, used for haptic feedback when enabled in Settings. The app does not read or change any system setting itself.</string>

    <string name="privacy_data_title">Your data</string>
    <string name="privacy_data_body">Nothing is collected, stored off your device or shared. Your haptic preference stays on this device.</string>

    <string name="privacy_tracking_title">Ads and tracking</string>
    <string name="privacy_tracking_body">There are no ads, analytics or trackers.</string>

    <string name="privacy_links_title">Open source and links</string>
    <string name="privacy_links_body">The source code is public, so you can verify how the app works. The Source Code, License and GitHub links open your browser. Quick Slate does not control those external websites.</string>

    <string name="privacy_changes_title">Changes</string>
    <string name="privacy_changes_body">If this policy changes, it will be updated here in the app.</string>

